# Copie para .env e preencha com os valores reais (o .env nunca vai para o git)

# Banco de dados SQLite (drive de rede do consultorio)
DATABASE_PATH=M:/caminho/para/receitas.db
BACKUP_DIR=M:/caminho/para/backups

# Prescritor
MEDICO_NOME=
MEDICO_CRM=
MEDICO_RQE=
MEDICO_CNS=

# Estabelecimento (LME)
LME_CNES=
LME_ESTABELECIMENTO=

# Cidade padrao dos documentos
CIDADE_PADRAO=Barretos
